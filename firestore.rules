rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Customers Collection: Allow read and write for ISP application
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Plan Upgrade Requests: Allow subscribers and admin to read and write
    match /upgradeRequests/{requestId} {
      allow read, write: if true;
    }

    // Payments & Receipts: Allow collection records
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // Invoices
    match /invoices/{invoiceId} {
      allow read, write: if true;
    }
  }
}
